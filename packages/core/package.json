{
  "name": "@ausm/core",
  "version": "0.1.0",
  "description": "Activity Understanding and Scaffolding Medium - System-level user activity monitoring API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "runtime": [
        "./dist/runtime.d.ts"
      ],
      "clients": [
        "./dist/clients.d.ts"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/runtime.mjs"
      },
      "require": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      }
    },
    "./clients": {
      "import": {
        "types": "./dist/clients.d.mts",
        "default": "./dist/clients.mjs"
      },
      "require": {
        "types": "./dist/clients.d.ts",
        "default": "./dist/clients.js"
      }
    }
  },
  "files": [
    "dist",
    "src/memory/py",
    "detectors",
    "LICENSE"
  ],
  "bin": {
    "memory-service": "./dist/memory-service.js"
  },
  "scripts": {
    "build": "tsup",
    "build:base": "TSUP_PHASE=base tsup",
    "build:runtime": "TSUP_PHASE=runtime tsup",
    "dev": "tsup --watch --no-dts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "TSX_TSCONFIG_PATH=tests/tsconfig.json node --require ./src/memory/tests/fixtures/register-fake-transformers.cjs --import tsx --test 'tests/*.test.ts' 'src/**/tests/*.test.ts'",
    "test:py": "python3 -m unittest discover -s src/memory/tests -p 'test_*.py'"
  },
  "peerDependencies": {
    "electron": ">=20.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "better-sqlite3": "^12.11.1",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "optionalDependencies": {
    "@ausm/device-macos-text-selection": "0.1.0",
    "@ausm/device-macos-screenshot-detector": "0.1.0",
    "@ausm/device-macos-clipboard-monitor": "0.1.0",
    "@ausm/device-macos-camera": "0.1.0",
    "@ausm/device-macos-cursor-plus-plus": "0.1.0",
    "@ausm/device-macos-screen-stream": "0.1.0",
    "@ausm/device-macos-viewport-manager": "0.1.0",
    "@ausm/device-macos-text-input": "0.1.0",
    "@ausm/device-macos-material-manager": "0.1.0",
    "@ausm/detector-pipeline": "0.1.0",
    "@ausm/material-chat": "0.1.0",
    "node-gyp-build": "^4.8.4"
  },
  "keywords": [
    "electron",
    "activity",
    "monitoring",
    "events"
  ],
  "author": "Aware",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/foundation-interface/ausm.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/foundation-interface/ausm",
  "bugs": {
    "url": "https://github.com/foundation-interface/ausm/issues"
  }
}
