{
  "name": "@ausm/device-macos-material-manager",
  "version": "0.1.0",
  "description": "Window material tracking for AUSM (macOS): crops window regions from screen-stream frames, dedupes with tiled pHash, and emits MaterialEvents",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "material-manager-service": "./dist/service.js"
  },
  "files": [
    "dist",
    "py/frame_reader.py",
    "py/requirements.txt",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:py": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "py:install": "python3 -m pip install -r py/requirements.txt",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "peerDependencies": {
    "@ausm/device-macos-screen-stream": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@ausm/device-macos-screen-stream": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "author": "Aware",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/foundation-interface/ausm.git",
    "directory": "device-macos/material-manager"
  },
  "homepage": "https://github.com/foundation-interface/ausm",
  "bugs": {
    "url": "https://github.com/foundation-interface/ausm/issues"
  }
}
