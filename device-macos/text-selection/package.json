{
  "name": "@ausm/device-macos-text-selection",
  "version": "0.1.0",
  "description": "System-wide text selection monitoring for AUSM on macOS (Accessibility API, Node-API addon)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./ausm-adapter": {
      "import": {
        "types": "./dist/ausm-adapter.d.mts",
        "default": "./dist/ausm-adapter.mjs"
      },
      "require": {
        "types": "./dist/ausm-adapter.d.ts",
        "default": "./dist/ausm-adapter.js"
      }
    }
  },
  "files": [
    "dist",
    "binding.gyp",
    "src",
    "prebuilds",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "install": "node-gyp-build",
    "rebuild": "node-gyp rebuild",
    "build:prebuilds": "prebuildify --napi --platform=darwin --arch=arm64 && prebuildify --napi --platform=darwin --arch=x64",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "tsup --watch",
    "clean": "rm -rf dist prebuilds build",
    "demo": "node examples/demo.js",
    "prepublishOnly": "npm run build:prebuilds && npm run build"
  },
  "keywords": [
    "ausm",
    "text-selection",
    "accessibility",
    "macos",
    "native"
  ],
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^8.4.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "node-gyp": "^11.2.0",
    "prebuildify": "^6.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin"
  ],
  "gypfile": true,
  "author": "Timeless",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timeless/ausm.git",
    "directory": "device-macos/text-selection"
  },
  "homepage": "https://github.com/timeless/ausm",
  "bugs": {
    "url": "https://github.com/timeless/ausm/issues"
  }
}
