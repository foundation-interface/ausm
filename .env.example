# ─── AUSM Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in the values you need.

# ─── Code Signing (screen-stream helper) ────────────────────────────────────
# macOS codesign identity for the Swift screen-capture helper binary.
# Use "-" for ad-hoc signing (works locally without a developer certificate).
# To find your identities: security find-identity -v -p codesigning
# SIGN_IDENTITY=-

# ─── Detector pipeline ──────────────────────────────────────────────────────
# Required to evaluate detectors/*/DETECTOR.md (rapid-task) and emit TaskEvent.
# Provider: vertex (default) or cerebras.
#
# Vertex / Gemini:
# Authenticate with: gcloud auth application-default login
# TASK_DETECTOR_PROVIDER=vertex
# TASK_DETECTOR_PROJECT_ID=your-gcp-project-id
# TASK_DETECTOR_LOCATION=global
# TASK_DETECTOR_MODEL=gemini-2.0-flash
#
# Cerebras (vision: gemma-4-31b). Key from https://cloud.cerebras.ai
# TASK_DETECTOR_PROVIDER=cerebras
# CEREBRAS_API_KEY=your-cerebras-api-key
# TASK_DETECTOR_MODEL=gemma-4-31b
